# Coolify: set these on the Eltemur application. Do not commit real values.
#
# Runtime only (available while the container is running; restart after a change):
#   CONTACT_FORM_ENDPOINT
#
# Build time and runtime (a change requires Redeploy, not only Restart):
#   NEXT_PUBLIC_SITE_URL
#   NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
#   NEXT_PUBLIC_BING_SITE_VERIFICATION
#   NEXT_PUBLIC_GA_MEASUREMENT_ID
#   INDEXNOW_KEY
#
# If NEXT_PUBLIC_SITE_URL is missing or invalid, the site uses https://eltemur.com.

# Contact form
# Full HTTPS URL that receives a JSON POST when someone submits the project form.
# Leave this unset until the endpoint exists. The form will validate input and
# tell the visitor the message was not sent.
#
# Expected JSON body:
# {
#   "to": "eltemurzentra@gmail.com",
#   "name": "string",
#   "email": "string",
#   "company": "string",
#   "projectType": "string",
#   "budget": "string",
#   "description": "string",
#   "source": "eltemur-zentra-studio-website"
# }
CONTACT_FORM_ENDPOINT=

# Canonical site URL. One https hostname, no trailing slash, no path.
# www.eltemur.com redirects to this host.
NEXT_PUBLIC_SITE_URL=https://eltemur.com

# Optional. Content value from the Google Search Console HTML tag, not the full tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. Content value from the Bing Webmaster meta tag (msvalidate.01).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional. Google Analytics 4 measurement ID, for example G-XXXXXXXX.
# The tag is added only on the configured https host.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Public IndexNow key, 8 to 128 letters, numbers, or hyphens.
# When set at build time, the key file is served at /{INDEXNOW_KEY}.txt
# Submit changed URLs after deployment with: npm run indexnow
# Do not run that command during local development.
INDEXNOW_KEY=
